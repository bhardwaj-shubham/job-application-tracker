generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

enum ApplicationStatus {
  APPLIED
  INTERVIEWING
  OFFERED
  REJECTED
  WITHDRAWN
}

model Application {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         String
  role            String
  jobUrl          String?
  status          ApplicationStatus @default(APPLIED)
  appliedDate     DateTime          @default(now())
  jobDescription  String?
  extractedSkills String[]
  notes           Note[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  documents      Document[]
  statusHistory  StatusHistory[]
  resumeAnalysis ResumeAnalysis?

  @@index([userId])
}

model Note {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  content       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
}

enum DocType {
  RESUME
  COVER_LETTER
  PORTFOLIO
  OTHER
}

model Document {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          DocType     @default(RESUME)
  filename      String
  mimetype      String
  resourceType  String
  url           String
  publicId      String
  uploadedAt    DateTime    @default(now())

  @@index([applicationId])
}

model StatusHistory {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  changedAt     DateTime          @default(now())

  @@index([applicationId])
}

model ResumeAnalysis {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchScore         Int?
  summary            String?
  matchingSkills     Json?
  missingSkills      Json?
  relevantExperience Json?
  resumeImprovements Json?
  keywordSuggestions Json?
  strengths          Json?
  concerns           Json?

  model         String
  promptVersion String
  status        AnalysisStatus @default(PENDING)

  errorCode    String?
  errorMessage String?

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
